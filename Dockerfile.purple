# Slim Dockerfile for the Sprint 4 purple agent.
# Uses requirements-purple.txt (not the full pyproject.toml) so the image
# stays small enough for the AgentBeats GitHub Actions runner to extract.
FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# uv for fast, reproducible installs.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

WORKDIR /app

# Install only the purple's deps — no vllm/torch/transformers.
COPY requirements-purple.txt .
RUN uv pip install --system --no-cache -r requirements-purple.txt

# Only ship what the purple actually imports.
COPY src/purple_logic src/purple_logic
COPY main.py .

ENV PYTHONPATH="/app:/app/src"

EXPOSE 9010

# AgentBeats overrides CMD args (--host, --port, --card-url) when scheduling
# assessments; defaults below are for local runs.
ENTRYPOINT ["python3", "main.py", "--role", "PURPLE"]
CMD ["--host", "0.0.0.0", "--port", "9010"]
